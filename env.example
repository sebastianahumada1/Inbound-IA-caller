# Server Configuration
PORT=3000
NODE_ENV=development

# Webhook Security
WEBHOOK_TOKEN=your_secure_webhook_token_here

# CORS Configuration
CORS_ORIGIN=*

# GHL Incoming Webhook URLs
GHL_INCOMING_WEBHOOK_URL_DEFAULT=https://services.leadconnectorhq.com/hooks/your_default_webhook_id
GHL_INCOMING_WEBHOOK_URL_BOOKING=https://services.leadconnectorhq.com/hooks/your_booking_webhook_id
GHL_INCOMING_WEBHOOK_URL_DEPOSIT=https://services.leadconnectorhq.com/hooks/your_deposit_webhook_id

# GHL API Configuration (for direct API calls)
GHL_API_KEY=your_ghl_api_key_here
GHL_API_KEY_SECONDARY=your_secondary_ghl_api_key_here
GHL_API_KEY_THIRD=your_third_ghl_api_key_here
GHL_API_KEY_FOURTH=your_fourth_ghl_api_key_here

# Assistant ID mapping for third and fourth API keys
GHL_THIRD_ASSISTANT_ID=39ba1969-84bf-4991-ab9e-9b234178f5c2
GHL_FOURTH_ASSISTANT_ID=30abcadf-9a7c-4db7-8e5f-3d82977f1f5d

# Vapi API Configuration (for metadata pulling)
VAPI_API_KEY=your_vapi_api_key_here
VAPI_API_BASE_URL=https://api.vapi.ai

# Slack Configuration (for recording uploads)
SLACK_BOT_TOKEN=your_slack_bot_token_here
SLACK_CHANNEL_ID=C09J96WA942

# Optional: Client-specific Slack channels (if you want different channels per client)
SLACK_CHANNEL_ID_PREMIER_WELLNESS=C09J96WA942
SLACK_CHANNEL_ID_WEST_TEXAS=C09J96WA942
SLACK_CHANNEL_ID_THIRD_CLIENT=C09J96WA942
SLACK_CHANNEL_ID_DATA_DRIVEN_PRACTICES=C09J96WA942
